{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-list-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  // Non-secret config only. Secrets (BETTER_AUTH_SECRET) live in .dev.vars
  // for local dev and `wrangler secret put` for the deployed worker — never in
  // vars, which are baked into the bundle as plaintext.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BETTER_AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
  },
  "dev": {
    "ip": "0.0.0.0",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "devDb",
      "database_name": "dev-db-shopping-list",
      "database_id": "74281f5c-c84d-4b53-8091-9d8947336520",
      "migrations_dir": "drizzle",
    },
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
