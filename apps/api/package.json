{
  "name": "@shopping-list/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./domain": {
      "types": "./src/domain.ts",
      "import": "./src/domain.ts"
    }
  },
  "scripts": {
    "dev": "cd ../.. && alchemy dev",
    "dev:e2e": "cd ../.. && alchemy state delete -r ShoppingList/e2e && ALCHEMY_STAGE=e2e alchemy dev --stage e2e --env-file apps/api/.dev.vars.e2e",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "better-auth": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "miniflare": "5.20260825.0-alpha",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
