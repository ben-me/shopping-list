{
  "name": "@shopping-list/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5174 --strictPort",
    "build": "pnpm type-check && pnpm build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "generate-pwa-assets": "pwa-assets-generator",
    "type-check": "vue-tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@shopping-list/api": "workspace:*",
    "better-auth": "catalog:",
    "dexie": "^4.4.5",
    "ofetch": "^1.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-playwright": "^2.10.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "^0.3.0",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.7"
  }
}
