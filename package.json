{
  "name": "shopping-list",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "preview": "pnpm --filter @shopping-list/web run preview",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "type-check": "pnpm -r --if-present run type-check",
    "lint": "pnpm -r --if-present run lint"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.118",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
